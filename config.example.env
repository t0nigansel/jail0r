# jail0r connection configuration
#
# Copy to .env, edit, then `. ./.env` before running.

# Target endpoint. POST with JSON body.
export JAIL0R_TARGET_URL="https://example.com/chat"

# Bearer token. Leave empty for endpoints without auth.
export JAIL0R_BEARER_TOKEN=""

# Directory with attack prompts. One .txt file per category, one prompt per line.
export JAIL0R_ATTACKS_DIR="attacks"

# JSON field that holds the user prompt.
# Ignored when JAIL0R_REQUEST_TEMPLATE_FILE is set.
export JAIL0R_JSON_FIELD="message"

# Optional: full request body template. Use {{prompt}} as placeholder.
# When set, this overrides JAIL0R_JSON_FIELD.
# export JAIL0R_REQUEST_TEMPLATE_FILE="examples/openai-chat.json"

# Optional: request timeout in seconds.
export JAIL0R_TIMEOUT_SECONDS=60

# Optional: directory for results. Defaults to "results".
export JAIL0R_RESULTS_DIR="results"
